<?xml version="1.0" encoding="UTF-8"?>
<!-- DatasheetXML schema. Author: Shishir Dey. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:d="https://datasheet.org/schema/v1"
           targetNamespace="https://datasheet.org/schema/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="0.3">

  <!-- ======================================================================
       Root element
       ====================================================================== -->
  <xs:element name="Datasheet" type="d:DatasheetType"/>

  <xs:complexType name="DatasheetType">
    <xs:sequence>
      <xs:element name="identification"  type="d:IdentificationType"/>
      <xs:element name="electrical"      type="d:ElectricalType"    minOccurs="0"/>
      <xs:element name="mechanical"      type="d:MechanicalType"    minOccurs="0"/>
      <xs:element name="thermal"         type="d:ThermalType"       minOccurs="0"/>
      <xs:element name="material"        type="d:MaterialType"      minOccurs="0"/>
      <xs:element name="environmental"   type="d:EnvironmentalType" minOccurs="0"/>
      <xs:element name="reliability"     type="d:ReliabilityType"   minOccurs="0"/>
      <xs:element name="regulatory"      type="d:RegulatoryType"    minOccurs="0"/>
      <xs:element name="manufacturing"   type="d:ManufacturingType" minOccurs="0"/>
      <xs:element name="commercial"      type="d:CommercialType"    minOccurs="0"/>
      <xs:element name="packaging"       type="d:PackagingType"     minOccurs="0"/>
      <xs:element name="documentation"   type="d:DocumentationType" minOccurs="0"/>
      <xs:element name="edaModels"       type="d:EdaModelsType"     minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required"/>
    <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="0.3"/>
  </xs:complexType>

  <!-- ======================================================================
       Reusable Property wrapper (IEC 61360 style)
       ====================================================================== -->
  <xs:complexType name="PropertyType">
    <xs:sequence>
      <xs:element name="value" type="xs:anySimpleType" minOccurs="0"/>
      <xs:element name="unit" type="xs:string" minOccurs="0"/>
      <xs:element name="dataType" type="d:DataTypeEnum" minOccurs="0"/>
      <xs:element name="conditionOfApplication" type="xs:string" minOccurs="0"/>
      <xs:element name="tolerance" type="xs:string" minOccurs="0"/>
      <xs:element name="minValue" type="xs:double" minOccurs="0"/>
      <xs:element name="typValue" type="xs:double" minOccurs="0"/>
      <xs:element name="maxValue" type="xs:double" minOccurs="0"/>
      <xs:element name="definition" type="xs:string" minOccurs="0"/>
      <xs:element name="irdi" type="d:IrdiType" minOccurs="0"/>
      <xs:element name="source" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="DataTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="INTEGER_MEASURE"/>
      <xs:enumeration value="REAL_MEASURE"/>
      <xs:enumeration value="STRING"/>
      <xs:enumeration value="BOOLEAN"/>
      <xs:enumeration value="ENUM"/>
      <xs:enumeration value="RANGE"/>
      <xs:enumeration value="RATIONAL_MEASURE"/>
      <xs:enumeration value="INTEGER_COUNT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IrdiType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{4}#[0-9]{2}-[A-Z0-9]+#[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ======================================================================
       Identification
       ====================================================================== -->
  <xs:simpleType name="DesignatorCategoryEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="A"><xs:annotation><xs:documentation>Removable Sub-assembly or Plug-in Module</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="AE"><xs:annotation><xs:documentation>Antenna</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="BT"><xs:annotation><xs:documentation>Battery</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="C"><xs:annotation><xs:documentation>Capacitor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="D"><xs:annotation><xs:documentation>Diode</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="DS"><xs:annotation><xs:documentation>Display</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="F"><xs:annotation><xs:documentation>Fuse</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="FB"><xs:annotation><xs:documentation>Ferrite Bead</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="FD"><xs:annotation><xs:documentation>Fiducial</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="FL"><xs:annotation><xs:documentation>Filter</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="H"><xs:annotation><xs:documentation>Hardware</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="J"><xs:annotation><xs:documentation>Jack</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="JP"><xs:annotation><xs:documentation>Jumper / Link</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="K"><xs:annotation><xs:documentation>Relay</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="L"><xs:annotation><xs:documentation>Inductor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="LS"><xs:annotation><xs:documentation>Loudspeaker or Buzzer</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="M"><xs:annotation><xs:documentation>Motor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="MK"><xs:annotation><xs:documentation>Microphone</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="P"><xs:annotation><xs:documentation>Plug</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="Q"><xs:annotation><xs:documentation>Transistor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="R"><xs:annotation><xs:documentation>Resistor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="RN"><xs:annotation><xs:documentation>Resistor Network</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="RT"><xs:annotation><xs:documentation>Thermistor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="RV"><xs:annotation><xs:documentation>Varistor</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="SW"><xs:annotation><xs:documentation>Switch</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="T"><xs:annotation><xs:documentation>Transformer</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="TC"><xs:annotation><xs:documentation>Thermocouple</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="TJ"><xs:annotation><xs:documentation>Thermal Jumper</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="TP"><xs:annotation><xs:documentation>Test Point</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="U"><xs:annotation><xs:documentation>Integrated Circuit</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="Y"><xs:annotation><xs:documentation>Crystal / Oscillator</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="Z"><xs:annotation><xs:documentation>Zener Diode</xs:documentation></xs:annotation></xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="IdentificationType">
    <xs:sequence>
      <xs:element name="referenceDesignator">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="(A|AE|BT|C|D|DS|F|FB|FD|FL|H|J|JP|K|L|LS|M|MK|P|Q|R|RN|RT|RV|SW|T|TC|TJ|TP|U|Y|Z)[0-9]+[A-Za-z]?"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="designatorCategory" type="d:DesignatorCategoryEnum"/>
      <xs:element name="designatorCategoryLabel" type="xs:string" minOccurs="0"/>
      <xs:element name="manufacturerPartNumber" type="xs:string" minOccurs="0"/>
      <xs:element name="manufacturer" type="xs:string" minOccurs="0"/>
      <xs:element name="internalPartNumber" type="xs:string" minOccurs="0"/>
      <xs:element name="genericPartFamily" type="xs:string" minOccurs="0"/>
      <xs:element name="irdiClassId" type="xs:string" minOccurs="0"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="revision" type="xs:string" minOccurs="0"/>
      <xs:element name="alternatePartNumbers" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="partNumber" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="eccnClassification" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Electrical
       ====================================================================== -->
  <xs:complexType name="ElectricalType">
    <xs:sequence>
      <xs:element name="voltageRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="currentRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="powerRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="resistance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="capacitance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="inductance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="impedance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="frequencyRange" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="tolerance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="temperatureCoefficient" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="dielectricType" type="xs:string" minOccurs="0"/>
      <xs:element name="polarized" type="xs:boolean" minOccurs="0"/>
      <xs:element name="pinCount" type="xs:integer" minOccurs="0"/>
      <xs:element name="logicFamily" type="xs:string" minOccurs="0"/>
      <xs:element name="switchingCharacteristics" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="insulationResistance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="dielectricWithstandingVoltage" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="esdRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="additionalProperties" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="property" type="d:PropertyType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Mechanical
       ====================================================================== -->
  <xs:simpleType name="MountingTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SMT"/> <xs:enumeration value="THT"/>
      <xs:enumeration value="Press-fit"/> <xs:enumeration value="Panel-mount"/>
      <xs:enumeration value="Chassis-mount"/> <xs:enumeration value="Free-standing"/>
      <xs:enumeration value="Other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConnectorGenderEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Male"/> <xs:enumeration value="Female"/> <xs:enumeration value="N/A"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="DimensionsType">
    <xs:sequence>
      <xs:element name="length" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="width" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="height" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="diameter" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="leadPitch" type="d:PropertyType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MechanicalType">
    <xs:sequence>
      <xs:element name="packageType" type="xs:string" minOccurs="0"/>
      <xs:element name="footprint" type="xs:string" minOccurs="0"/>
      <xs:element name="dimensions" type="d:DimensionsType" minOccurs="0"/>
      <xs:element name="mass" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="mountingType" type="d:MountingTypeEnum" minOccurs="0"/>
      <xs:element name="terminationStyle" type="xs:string" minOccurs="0"/>
      <xs:element name="mechanicalTolerance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="connectorGender" type="d:ConnectorGenderEnum" minOccurs="0"/>
      <xs:element name="keying" type="xs:string" minOccurs="0"/>
      <xs:element name="actuationForce" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="vibrationResistance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="shockResistance" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="cadModelRef" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Thermal
       ====================================================================== -->
  <xs:complexType name="ThermalType">
    <xs:sequence>
      <xs:element name="operatingTemperatureRange" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="storageTemperatureRange" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="thermalResistanceJunctionAmbient" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="thermalResistanceJunctionCase" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="maxJunctionTemperature" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="derating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="thermalConductivity" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="reflowProfileCompatibility" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Material
       ====================================================================== -->
  <xs:complexType name="MaterialCompositionEntryType">
    <xs:sequence>
      <xs:element name="substance" type="xs:string" minOccurs="0"/>
      <xs:element name="casNumber" type="xs:string" minOccurs="0"/>
      <xs:element name="massFraction" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MaterialType">
    <xs:sequence>
      <xs:element name="bodyMaterial" type="xs:string" minOccurs="0"/>
      <xs:element name="terminationFinish" type="xs:string" minOccurs="0"/>
      <xs:element name="substrateMaterial" type="xs:string" minOccurs="0"/>
      <xs:element name="encapsulantMaterial" type="xs:string" minOccurs="0"/>
      <xs:element name="flammabilityRating" type="xs:string" minOccurs="0"/>
      <xs:element name="moistureSensitivityLevel" type="xs:string" minOccurs="0"/>
      <xs:element name="colorFinish" type="xs:string" minOccurs="0"/>
      <xs:element name="magneticProperties" type="xs:string" minOccurs="0"/>
      <xs:element name="materialComposition" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="substance" type="d:MaterialCompositionEntryType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Environmental
       ====================================================================== -->
  <xs:simpleType name="ConflictMineralsStatusEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DRC Conflict-Free"/>
      <xs:enumeration value="Not Conflict-Free"/>
      <xs:enumeration value="Not Assessed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EnvironmentalType">
    <xs:sequence>
      <xs:element name="rohsCompliant" type="xs:boolean" minOccurs="0"/>
      <xs:element name="rohsVersion" type="xs:string" minOccurs="0"/>
      <xs:element name="reachCompliant" type="xs:boolean" minOccurs="0"/>
      <xs:element name="reachSvhcListDate" type="xs:date" minOccurs="0"/>
      <xs:element name="halogenFree" type="xs:boolean" minOccurs="0"/>
      <xs:element name="conflictMineralsStatus" type="d:ConflictMineralsStatusEnum" minOccurs="0"/>
      <xs:element name="ingressProtectionRating" type="xs:string" minOccurs="0"/>
      <xs:element name="humidityRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="altitudeRating" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="chemicalResistance" type="xs:string" minOccurs="0"/>
      <xs:element name="uvResistance" type="xs:boolean" minOccurs="0"/>
      <xs:element name="californiaProp65" type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Reliability
       ====================================================================== -->
  <xs:complexType name="EnduranceType">
    <xs:sequence>
      <xs:element name="cycleCount" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="testMethod" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReliabilityType">
    <xs:sequence>
      <xs:element name="mtbf" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="failureRate" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="ratedLifetime" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="qualificationStandard" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="standard" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="gradeLevel" type="xs:string" minOccurs="0"/>
      <xs:element name="burnInTested" type="xs:boolean" minOccurs="0"/>
      <xs:element name="predictedFailureModes" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="mode" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="endurance" type="d:EnduranceType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Regulatory
       ====================================================================== -->
  <xs:complexType name="RegulatoryType">
    <xs:sequence>
      <xs:element name="certifications" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="certification" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="certificateNumbers" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="certificateNumber" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="eccn" type="xs:string" minOccurs="0"/>
      <xs:element name="htsCode" type="xs:string" minOccurs="0"/>
      <xs:element name="countryOfOrigin" type="xs:string" minOccurs="0"/>
      <xs:element name="exportLicenseRequired" type="xs:boolean" minOccurs="0"/>
      <xs:element name="ituCompliance" type="xs:string" minOccurs="0"/>
      <xs:element name="iecStandardRef" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="standard" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Manufacturing
       ====================================================================== -->
  <xs:simpleType name="AssemblyProcessEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SMT-Reflow"/> <xs:enumeration value="THT-Wave"/>
      <xs:enumeration value="THT-Selective"/> <xs:enumeration value="Manual"/>
      <xs:enumeration value="Press-fit"/> <xs:enumeration value="Other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ManufacturingType">
    <xs:sequence>
      <xs:element name="assemblyProcess" type="d:AssemblyProcessEnum" minOccurs="0"/>
      <xs:element name="solderReflowProfile" type="xs:string" minOccurs="0"/>
      <xs:element name="leadFreeProcessCompatible" type="xs:boolean" minOccurs="0"/>
      <xs:element name="peakReflowTemperature" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="solderabilityStandard" type="xs:string" minOccurs="0"/>
      <xs:element name="placementOrientation" type="xs:string" minOccurs="0"/>
      <xs:element name="testCoverage" type="xs:string" minOccurs="0"/>
      <xs:element name="yieldRate" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="processCapabilityIndex" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="traceabilityMethod" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Commercial
       ====================================================================== -->
  <xs:simpleType name="LifecycleStatusEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Active"/> <xs:enumeration value="NRND"/>
      <xs:enumeration value="EOL"/> <xs:enumeration value="Obsolete"/>
      <xs:enumeration value="Preview"/> <xs:enumeration value="Unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PriceBreakType">
    <xs:sequence>
      <xs:element name="quantity" type="xs:integer" minOccurs="0"/>
      <xs:element name="unitPrice" type="xs:double" minOccurs="0"/>
      <xs:element name="currency" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DistributorType">
    <xs:sequence>
      <xs:element name="name" type="xs:string" minOccurs="0"/>
      <xs:element name="sku" type="xs:string" minOccurs="0"/>
      <xs:element name="stockQuantity" type="xs:integer" minOccurs="0"/>
      <xs:element name="url" type="xs:anyURI" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CommercialType">
    <xs:sequence>
      <xs:element name="lifecycleStatus" type="d:LifecycleStatusEnum" minOccurs="0"/>
      <xs:element name="lastTimeBuyDate" type="xs:date" minOccurs="0"/>
      <xs:element name="endOfLifeDate" type="xs:date" minOccurs="0"/>
      <xs:element name="leadTimeWeeks" type="xs:double" minOccurs="0"/>
      <xs:element name="minimumOrderQuantity" type="xs:integer" minOccurs="0"/>
      <xs:element name="standardPackQuantity" type="xs:integer" minOccurs="0"/>
      <xs:element name="priceBreaks" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="priceBreak" type="d:PriceBreakType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="distributors" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="distributor" type="d:DistributorType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="alternateSources" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="partNumber" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="obsolescenceRiskScore" type="xs:double" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================================
       Packaging
       ====================================================================== -->
  <xs:simpleType name="PackingMethodEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Tape and Reel"/> <xs:enumeration value="Tube"/>
      <xs:enumeration value="Tray"/> <xs:enumeration value="Bulk"/>
      <xs:enumeration value="Cut Tape"/> <xs:enumeration value="Bag"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PackagingType">
    <xs:sequence>
      <xs:element name="packingMethod" type="d:PackingMethodEnum" minOccurs="0"/>
      <xs:element name="reelSize" type="xs:string" minOccurs="0"/>
      <xs:element name="quantityPerReel" type="xs:integer" minOccurs="0"/>
      <xs:element name="tapeWidth" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="tapePitch" type="d:PropertyType" minOccurs="0"/>
      <xs:element name="orientation" type="xs:string" minOccurs="0"/>
      <xs:element name="dryPackRequired" type="xs:boolean" minOccurs="0"/>
      <xs:element name="packagingMaterial" type="xs:string" minOccurs="0"/>
      <xs:element name="labelingStandard" type="xs:string" minOccurs="0"/>
